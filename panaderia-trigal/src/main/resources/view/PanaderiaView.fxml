<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="viewControllers.PanaderiaViewController"
            prefWidth="1200" prefHeight="680">
    <padding>
        <Insets top="12" right="12" bottom="12" left="12"/>
    </padding>

    <top>
        <Label text="Panadería El Trigal" style="-fx-font-size: 22px; -fx-font-weight: bold;">
            <padding>
                <Insets bottom="10"/>
            </padding>
        </Label>
    </top>

    <center>
        <HBox spacing="16">

            <!-- ===================== EMPLEADOS ===================== -->
            <VBox spacing="8" HBox.hgrow="ALWAYS" prefWidth="500">
                <Label text="Empleados" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

                <GridPane hgap="8" vgap="6">
                    <columnConstraints>
                        <ColumnConstraints minWidth="90"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>

                    <Label text="Tipo" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <ComboBox fx:id="cmbTipoEmpleado" maxWidth="Infinity"
                              GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                    <Label text="Nombre" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <TextField fx:id="txtEmpNombre" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                    <Label text="Documento" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                    <TextField fx:id="txtEmpDocumento" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                    <Label text="Código" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                    <TextField fx:id="txtEmpCodigo" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                    <Label text="Minutos disp." GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                    <TextField fx:id="txtEmpMinutos" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                    <Label text="N.º de caja" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                    <TextField fx:id="txtEmpCaja" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
                </GridPane>

                <Button text="Agregar empleado" onAction="#onAgregarEmpleado"/>

                <TableView fx:id="tblEmpleados" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colEmpCodigo" text="Código" prefWidth="70"/>
                        <TableColumn fx:id="colEmpNombre" text="Nombre" prefWidth="110"/>
                        <TableColumn fx:id="colEmpDocumento" text="Documento" prefWidth="90"/>
                        <TableColumn fx:id="colEmpTipo" text="Tipo" prefWidth="140"/>
                        <TableColumn fx:id="colEmpMinutos" text="Min. disp." prefWidth="75"/>
                    </columns>
                </TableView>
            </VBox>

            <!-- ===================== PEDIDOS ===================== -->
            <VBox spacing="8" HBox.hgrow="ALWAYS" prefWidth="640">
                <Label text="Pedidos" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

                <GridPane hgap="8" vgap="6">
                    <columnConstraints>
                        <ColumnConstraints minWidth="90"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>

                    <Label text="Código" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <TextField fx:id="txtPedCodigo" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                    <Label text="Cliente" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <TextField fx:id="txtPedCliente" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                    <Label text="Tipo de pan" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                    <ComboBox fx:id="cmbTipoPan" maxWidth="Infinity"
                              GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                    <Label text="Cantidad" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                    <TextField fx:id="txtPedCantidad" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                </GridPane>

                <HBox spacing="8">
                    <Button text="Registrar pedido" onAction="#onRegistrarPedido"/>
                    <Button text="Asignar seleccionado" onAction="#onAsignarPedido"/>
                    <Button text="Cancelar seleccionado" onAction="#onCancelarPedido"/>
                </HBox>

                <TableView fx:id="tblPedidos" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colPedCodigo" text="Código" prefWidth="65"/>
                        <TableColumn fx:id="colPedCliente" text="Cliente" prefWidth="110"/>
                        <TableColumn fx:id="colPedTipo" text="Pan" prefWidth="95"/>
                        <TableColumn fx:id="colPedCantidad" text="Cant." prefWidth="55"/>
                        <TableColumn fx:id="colPedEstado" text="Estado" prefWidth="95"/>
                        <TableColumn fx:id="colPedEmpleado" text="Empleado" prefWidth="80"/>
                        <TableColumn fx:id="colPedMinutos" text="Min. reserv." prefWidth="85"/>
                    </columns>
                </TableView>
            </VBox>
        </HBox>
    </center>

    <bottom>
        <Label fx:id="lblEstado" text="Listo.">
            <padding>
                <Insets top="10"/>
            </padding>
        </Label>
    </bottom>
</BorderPane>
